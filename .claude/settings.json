{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/design-guard-gate.sh stop",
            "timeout": 120,
            "statusMessage": "Running design-guard.sh before ending turn..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/design-guard-gate.sh pretooluse",
            "if": "Bash(git commit*)",
            "timeout": 120,
            "statusMessage": "Running design-guard.sh before commit..."
          }
        ]
      }
    ]
  }
}
