# Copy to .env and fill in real values. Never commit .env itself.
# See docs/13_DEPLOYMENT.md for the full setup guide.
# These are the exact variable names backend/config.py's Settings class
# reads — verified against the real code August 22, 2026. Two real
# footguns to know about:
#   - The JWT signing algorithm env var is JWT_ALGORITHM, not ALGORITHM.
#     Setting ALGORITHM does nothing (pydantic-settings silently ignores
#     unknown env vars) — it "worked" in ci.yml only because the default
#     already happens to be HS256.
#   - CORS is NOT read from this file at all — main.py reads CORS_ORIGINS
#     directly via os.environ, a separate path from this Settings class.
#     See the CORS_ORIGINS line below.

# Database
DATABASE_URL=postgresql+asyncpg://localhost/pharmacare

# App
APP_NAME=PharmaCare
DEBUG=true

# Auth — SECRET_KEY must be a real random string in any shared environment,
# not this placeholder. JWT_ALGORITHM is almost always HS256.
SECRET_KEY=change-me-in-dev-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated list of allowed frontend origins. Read directly by
# main.py, not through the Settings class above. "*" is rejected outright
# (invalid combined with allow_credentials=True) — main.py raises at
# startup if this resolves to an empty list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
