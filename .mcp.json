{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--executable-path=/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--no-sandbox",
        "--headless"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--executablePath=/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--chromeArg=--no-sandbox",
        "--headless"
      ],
      "env": {}
    }
  }
}