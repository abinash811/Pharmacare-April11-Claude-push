# Copy to .env (or .env.local for a git-ignored personal override) and fill
# in real values. See docs/13_DEPLOYMENT.md for the full setup guide.
# REACT_APP_ prefix is required — Create React App only exposes prefixed
# vars to the browser bundle.
#
# This is the only REACT_APP_ variable actually read anywhere in
# frontend/src today (verified by grep, August 22, 2026).
# staging.yml's build step also sets REACT_APP_SENTRY_DSN, REACT_APP_ENV,
# and REACT_APP_VERSION, but nothing in the app reads them yet — Sentry is
# committed but not initialized (see CLAUDE.md's infra-gaps list).

REACT_APP_BACKEND_URL=http://localhost:8000
