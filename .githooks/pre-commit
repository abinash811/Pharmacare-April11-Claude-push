#!/usr/bin/env bash
# PharmaCare pre-commit checks.
# Checks ONLY the files staged in this commit — pre-existing issues elsewhere
# in the repo never block an unrelated commit. The full-repo audit still runs
# in CI via scripts/design-guard.sh + flake8 + eslint before merge to main
# (see CLAUDE.md "Component audit" and docs/20_CODE_QUALITY.md).
#
# Every block below prints WHY it's blocking, with the source rule, so a
# blocked commit is never a mystery.
#
# One-time setup (per machine): git config core.hooksPath .githooks
# Emergency bypass (skips ALL checks — use sparingly): git commit --no-verify

set -uo pipefail
ERRORS=0

red()    { echo -e "\033[0;31m✗ $*\033[0m"; }
green()  { echo -e "\033[0;32m✓ $*\033[0m"; }
file()   { echo -e "\033[0;33m    $*\033[0m"; }
reason() { echo -e "\033[0;36m    → $*\033[0m"; }

STAGED=$(git diff --name-only --cached --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

FRONTEND_FILES=$(echo "$STAGED" | grep -E '^frontend/src/(pages|components)/.*\.(js|jsx|ts|tsx)$' || true)
FRONTEND_ALL_FILES=$(echo "$STAGED" | grep -E '^frontend/src/.*\.(js|jsx|ts|tsx)$' || true)
BACKEND_FILES=$(echo "$STAGED" | grep -E '^backend/.*\.py$' | grep -v -E '(^backend/venv/|/alembic/versions/)' || true)

echo ""
echo "PharmaCare pre-commit checks (staged files only)"
echo "─────────────────────────────────────────────────"

if [ -n "$FRONTEND_FILES" ]; then
  RAW=$(echo "$FRONTEND_FILES" | xargs grep -ln "<button" 2>/dev/null | grep -v "WelcomeCard" || true)
  if [ -n "$RAW" ]; then
    red "BLOCKED: raw <button> tag(s) found"
    echo "$RAW" | while read -r f; do file "$f"; done
    reason "CLAUDE.md Manifesto rule #1: every button must be <AppButton>, imported from '@/components/shared'. No raw <button> tags."
    ERRORS=$((ERRORS+1))
  fi

  HEX=$(echo "$FRONTEND_FILES" | xargs grep -ln "className=.*#[0-9a-fA-F]\{3,6\}" 2>/dev/null | grep -v "AuthPage" || true)
  if [ -n "$HEX" ]; then
    red "BLOCKED: hardcoded hex color(s) in className"
    echo "$HEX" | while read -r f; do file "$f"; done
    reason "CLAUDE.md Manifesto rule #2: use design tokens (bg-brand, text-brand, etc.), never a raw hex value like #4682B4."
    ERRORS=$((ERRORS+1))
  fi

  HOVERHEX=$(echo "$FRONTEND_FILES" | xargs grep -ln "hover:bg-\[#" 2>/dev/null || true)
  if [ -n "$HOVERHEX" ]; then
    red "BLOCKED: hover:bg-[#...] pattern found"
    echo "$HOVERHEX" | while read -r f; do file "$f"; done
    reason "Same token rule as above — hover states must use hover:bg-brand-dark, not a raw hex hover color."
    ERRORS=$((ERRORS+1))
  fi

  LONG=$(for f in $FRONTEND_FILES; do
    [ -f "$f" ] || continue
    lines=$(wc -l < "$f")
    [ "$lines" -gt 300 ] && echo "$f ($lines lines)"
  done)
  if [ -n "$LONG" ]; then
    red "BLOCKED: file(s) over the 300-line limit"
    echo "$LONG" | while read -r f; do file "$f"; done
    reason "CLAUDE.md Manifesto rule #4: no file over 300 lines. Split it — orchestrators import components, they don't contain the JSX logic."
    ERRORS=$((ERRORS+1))
  fi

  SHADCN=$(echo "$FRONTEND_FILES" | xargs grep -ln "from '@/components/ui/button'" 2>/dev/null || true)
  if [ -n "$SHADCN" ]; then
    red "BLOCKED: direct Shadcn ui/button import"
    echo "$SHADCN" | while read -r f; do file "$f"; done
    reason "Use AppButton from '@/components/shared' — it wraps Shadcn's button with the design system's variants baked in."
    ERRORS=$((ERRORS+1))
  fi

  MOREMENU=$(echo "$FRONTEND_FILES" | xargs grep -ln "top-full mt-1" 2>/dev/null | grep -v "MoreMenu.tsx" || true)
  if [ -n "$MOREMENU" ]; then
    red "BLOCKED: hand-rolled 'More menu' dropdown found"
    echo "$MOREMENU" | while read -r f; do file "$f"; done
    reason "This exact popover shape was independently duplicated across 3 pages before being extracted into <MoreMenu> (components/shared/MoreMenu.tsx) — one copy even shipped without a working close-on-outside-click. Use <MoreMenu items={[...]} /> instead."
    ERRORS=$((ERRORS+1))
  fi
fi

NEWJSX=$(git diff --name-only --cached --diff-filter=A | grep '\.jsx$' | grep -v node_modules || true)
if [ -n "$NEWJSX" ]; then
  red "BLOCKED: new .jsx file(s) staged"
  echo "$NEWJSX" | while read -r f; do file "$f"; done
  reason "CLAUDE.md: new files must use .tsx, not .jsx."
  ERRORS=$((ERRORS+1))
fi

DOC_FILES=$(echo "$STAGED" | grep -E '^(CLAUDE\.md|docs/.*\.md)$' || true)
if [ -n "$DOC_FILES" ]; then
  STALE_DOCS=""
  for f in $DOC_FILES; do
    [ -f "$f" ] || continue  # skip deleted files
    if ! git diff --cached -- "$f" | grep -qE '^[+-].*Last updated'; then
      STALE_DOCS="$STALE_DOCS$f
"
    fi
  done
  if [ -n "$STALE_DOCS" ]; then
    red "BLOCKED: doc content changed without updating its 'Last updated' line"
    echo "$STALE_DOCS" | while read -r f; do [ -n "$f" ] && file "$f"; done
    reason "This exact thing already happened 3 times silently (CLAUDE.md, docs/06, docs/08, docs/12 all had real content changes with a stale header) before anyone noticed. Bump the 'Last updated' line in the same commit as the content change."
    ERRORS=$((ERRORS+1))
  fi
fi

TOKEN_FILES_TOUCHED=$(echo "$STAGED" | grep -E "^(frontend/tailwind\.config\.js|PharmaCare Design System/colors_and_type\.css)$" || true)
if [ -n "$TOKEN_FILES_TOUCHED" ]; then
  TOKEN_SYNC_OUTPUT=$(python3 scripts/design_token_sync_check.py 2>&1) || true
  if ! echo "$TOKEN_SYNC_OUTPUT" | grep -q "^Design token sync check: OK"; then
    red "BLOCKED: design tokens disagree between tailwind.config.js and colors_and_type.css"
    echo "$TOKEN_SYNC_OUTPUT" | while read -r l; do file "$l"; done
    reason "Motion tokens disagreed between these two files for months before being caught by chance, not by any check. tailwind.config.js is the source of truth (it's what actually ships) — update colors_and_type.css to match."
    ERRORS=$((ERRORS+1))
  fi
fi

if [ -n "$FRONTEND_ALL_FILES" ] && [ -x frontend/node_modules/.bin/eslint ]; then
  echo ""
  echo "Running ESLint on staged frontend file(s) (new/changed lines only)..."
  ESLINT_OUTPUT=$(python3 scripts/eslint_changed_lines.py $FRONTEND_ALL_FILES)
  if [ -n "$ESLINT_OUTPUT" ]; then
    red "BLOCKED: ESLint found issue(s) on line(s) you added or changed"
    echo "$ESLINT_OUTPUT" | while read -r l; do file "$l"; done
    reason "docs/20_CODE_QUALITY.md + CI: new/changed frontend lines must pass ESLint. Pre-existing issues elsewhere in a touched file don't block — same policy as the checks above."
    ERRORS=$((ERRORS+1))
  fi
fi

if [ -n "$BACKEND_FILES" ] && [ -x backend/venv/bin/flake8 ]; then
  echo ""
  echo "Running flake8 on staged backend file(s) (new/changed lines only)..."
  FLAKE_OUTPUT=$(backend/venv/bin/python3 scripts/flake8_changed_lines.py $BACKEND_FILES)
  if [ -n "$FLAKE_OUTPUT" ]; then
    red "BLOCKED: flake8 found issue(s) on line(s) you added or changed"
    echo "$FLAKE_OUTPUT" | while read -r l; do file "$l"; done
    reason "docs/20_CODE_QUALITY.md + CI: new/changed backend lines must pass flake8 (max-line-length=100). Pre-existing issues elsewhere in a touched file don't block — same policy as the checks above."
    ERRORS=$((ERRORS+1))
  fi
fi

echo ""
if [ "$ERRORS" -eq 0 ]; then
  green "All pre-commit checks passed."
  exit 0
else
  red "$ERRORS check(s) failed — commit blocked until fixed."
  echo "Fix the issue(s) above, 'git add' the fix, and commit again."
  exit 1
fi
