# react-scripts@5.0.1 peer-depends on typescript ^3.2.1 || ^4, but the
# project uses typescript@5.9.3 (via @typescript-eslint) — a real,
# pre-existing conflict that npm's default resolver refuses (ERESOLVE).
# ci.yml/design-guard.yml already work around it with an explicit
# --legacy-peer-deps flag; this makes the same behavior apply to any npm
# install in this directory (local, CI, or a host's own implicit install
# step — e.g. Render's Blueprint deploy, which runs its own npm install
# before any buildCommand and has no flag to pass).
legacy-peer-deps=true
